# macOS 系统生成的隐藏文件
.DS_Store
# npm 包管理器的依赖目录，不需要提交
node_modules
# 编译后的构建目录
/dist


# local env files                                       # 本地环境变量文件
.env.local
.env.*.local

# Log files                                             # 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files                          # 编辑器相关文件和目录
# IntelliJ IDEA 编辑器配置
.idea
# Visual Studio Code 编辑器配置
.vscode
# Visual Studio 用户选项文件
*.suo
*.ntvs*
*.njsproj
# Visual Studio 解决方案文件
*.sln
# Vim 交换文件
*.sw?

# Configuration files containing sensitive data
*.conf
config.ini