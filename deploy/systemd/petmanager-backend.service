[Unit]
Description=PetManager Crow Backend Service
After=network.target mysql.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/petmanager
EnvironmentFile=/opt/petmanager/.env
ExecStart=/opt/petmanager/bin/start.sh
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
