digraph ConceptClassDiagram {
  graph [
    rankdir=LR,
    splines=polyline,
    overlap=false,
    fontname="PingFang SC",
    fontsize=18,
    label="宠物医院管理系统概念类图",
    labelloc="t",
    pad=0.4,
    nodesep=0.6,
    ranksep=1.0
  ];

  node [shape=record, fontname="PingFang SC", fontsize=12, color="#222222"];
  edge [fontname="PingFang SC", fontsize=10, color="#444444"];

  User [label="{用户|id\lname\lpassword\lphone\lemail\lbirthday\laddress\lheadImage\l}"];
  Doctor [label="{医生|doctorId\lspecialty\ldutyStatus\l}"];
  SuperAdmin [label="{超级管理员|adminId\l}"];
  WarehouseAdmin [label="{仓库管理员|managerId\l}"];
  Reservation [label="{预约|reservationId\ldate\ltimeSlot\lstatus\l}"];
  Order [label="{订单|orderId\lorderDate\lamount\lcontent\lstatus\l}"];
  WarehouseItem [label="{仓库物资|itemId\litemName\lquantity\lprice\lwarningLevel\l}"];
  Worktime [label="{工时记录|recordId\ldate\lcheckInTime\lcheckOutTime\l}"];

  User -> Reservation [label="发起"];
  Doctor -> Reservation [label="接诊"];
  User -> Order [label="拥有"];
  Doctor -> Order [label="创建"];
  Doctor -> Worktime [label="对应"];
  WarehouseAdmin -> WarehouseItem [label="管理"];
  SuperAdmin -> User [label="管理"];
  SuperAdmin -> Doctor [label="管理"];
  SuperAdmin -> Worktime [label="调整"];
}
