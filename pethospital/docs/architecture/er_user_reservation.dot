digraph ER_UserReservation {
  graph [charset="UTF-8", rankdir=LR, splines=polyline, fontname="PingFang SC", bgcolor="white", nodesep=0.9, ranksep=1.2];
  node [fontname="PingFang SC", fontsize=16, color="#333333"];
  edge [fontname="PingFang SC", fontsize=14, color="#444444"];

  types [shape=box, label="用户类型\ntypes"];
  users [shape=box, label="用户\nusers"];
  phones [shape=box, label="手机号索引\nphones"];
  pets [shape=box, label="宠物\npets"];
  reservations [shape=box, label="预约记录\nreaservations"];

  rel_user_type [shape=diamond, label="属于"];
  rel_user_phone [shape=diamond, label="绑定"];
  rel_user_pet [shape=diamond, label="拥有"];
  rel_user_reservation [shape=diamond, label="发起预约"];
  rel_doctor_reservation [shape=diamond, label="接诊"];

  types -> rel_user_type [label="1"];
  rel_user_type -> users [label="n"];

  users -> rel_user_phone [label="1"];
  rel_user_phone -> phones [label="n"];

  users -> rel_user_pet [label="1"];
  rel_user_pet -> pets [label="n"];

  users -> rel_user_reservation [label="1"];
  rel_user_reservation -> reservations [label="n"];

  users -> rel_doctor_reservation [label="1"];
  rel_doctor_reservation -> reservations [label="n"];
}
