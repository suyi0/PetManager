digraph ER_OrderInventory {
  graph [charset="UTF-8", rankdir=LR, splines=polyline, fontname="PingFang SC", bgcolor="white", nodesep=0.9, ranksep=1.2];
  node [fontname="PingFang SC", fontsize=16, color="#333333"];
  edge [fontname="PingFang SC", fontsize=14, color="#444444"];

  pets [shape=box, label="宠物\npets"];
  users [shape=box, label="医生用户\nusers"];
  orders [shape=box, label="订单\norders"];
  order_medicines [shape=box, label="订单药品明细\norderMedicines"];
  warehouse [shape=box, label="库存药品\nwarehouse"];

  rel_pet_order [shape=diamond, label="对应"];
  rel_doctor_order [shape=diamond, label="开立"];
  rel_order_detail [shape=diamond, label="包含"];
  rel_warehouse_detail [shape=diamond, label="引用"];

  pets -> rel_pet_order [label="1"];
  rel_pet_order -> orders [label="n"];

  users -> rel_doctor_order [label="1"];
  rel_doctor_order -> orders [label="n"];

  orders -> rel_order_detail [label="1"];
  rel_order_detail -> order_medicines [label="n"];

  warehouse -> rel_warehouse_detail [label="1"];
  rel_warehouse_detail -> order_medicines [label="n"];
}
