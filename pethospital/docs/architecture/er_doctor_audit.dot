digraph ER_DoctorAudit {
  graph [charset="UTF-8", rankdir=LR, splines=polyline, fontname="PingFang SC", bgcolor="white", nodesep=0.9, ranksep=1.2];
  node [fontname="PingFang SC", fontsize=16, color="#333333"];
  edge [fontname="PingFang SC", fontsize=14, color="#444444"];

  users [shape=box, label="用户/医生\nusers"];
  online_doctors [shape=box, label="医生在线状态\nonlineDoctors"];
  work_records [shape=box, label="工时记录\nworkTimeRecords"];
  user_ops [shape=box, label="用户操作日志\nuser_operations"];
  system_ops [shape=box, label="系统操作日志\nsystem_operations"];

  rel_online [shape=diamond, label="值班"];
  rel_record [shape=diamond, label="签到签退"];
  rel_userop [shape=diamond, label="产生"];

  users -> rel_online [label="1"];
  rel_online -> online_doctors [label="n"];

  users -> rel_record [label="1"];
  rel_record -> work_records [label="n"];

  users -> rel_userop [label="1"];
  rel_userop -> user_ops [label="n"];
}
