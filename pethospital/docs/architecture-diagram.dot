digraph ArchitectureDiagram {
  graph [
    rankdir=TB,
    splines=polyline,
    overlap=false,
    fontname="PingFang SC",
    fontsize=18,
    pad=0.5,
    nodesep=0.45,
    ranksep=0.8
  ];

  node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=12, color="#222222", fillcolor="white"];
  edge [fontname="PingFang SC", fontsize=10, color="#666666", arrowsize=0.8];

  subgraph cluster_ui {
    label="用户界面层";
    fontname="PingFang SC";
    fontsize=18;
    color="#d6b04c";
    style="rounded,filled";
    fillcolor="#fff2cc";

    UI_Login [label="登录/注册页面"];
    UI_User [label="普通用户端"];
    UI_Doctor [label="医生端"];
    UI_Warehouse [label="仓库管理员端"];
    UI_Admin [label="超级管理员端"];
  }

  subgraph cluster_domain {
    label="领域逻辑层";
    fontname="PingFang SC";
    fontsize=18;
    color="#6d9eeb";
    style="rounded,filled";
    fillcolor="#d9e7fb";

    Domain_Auth [label="认证管理"];
    Domain_User [label="用户管理"];
    Domain_Reservation [label="预约管理"];
    Domain_Order [label="订单管理"];
    Domain_Doctor [label="医生管理"];
    Domain_Warehouse [label="仓库管理"];
    Domain_Admin [label="后台管理"];
  }

  subgraph cluster_tech {
    label="技术服务层";
    fontname="PingFang SC";
    fontsize=18;
    color="#e06666";
    style="rounded,filled";
    fillcolor="#f9d9d9";

    Tech_DB [label="数据持久化\nDatabaseManager / MySQL"];
    Tech_Security [label="安全服务\nJWT / 加密 / 权限校验"];
    Tech_Log [label="日志服务\nOperationLogger"];
    Tech_Middleware [label="中间件服务\nCORS / 限流"];
    Tech_Task [label="定时任务\nScheduledTaskManager"];
  }

  UI_Login -> Domain_Auth;
  UI_User -> Domain_User;
  UI_User -> Domain_Reservation;
  UI_User -> Domain_Order;

  UI_Doctor -> Domain_Doctor;
  UI_Doctor -> Domain_Order;
  UI_Doctor -> Domain_Reservation;

  UI_Warehouse -> Domain_Warehouse;
  UI_Admin -> Domain_Admin;
  UI_Admin -> Domain_Doctor;
  UI_Admin -> Domain_User;

  Domain_Auth -> Tech_Security;
  Domain_Auth -> Tech_DB;
  Domain_User -> Tech_DB;
  Domain_User -> Tech_Security;
  Domain_Reservation -> Tech_DB;
  Domain_Reservation -> Tech_Task;
  Domain_Order -> Tech_DB;
  Domain_Doctor -> Tech_DB;
  Domain_Doctor -> Tech_Log;
  Domain_Warehouse -> Tech_DB;
  Domain_Warehouse -> Tech_Log;
  Domain_Admin -> Tech_DB;
  Domain_Admin -> Tech_Security;

  Domain_Auth -> Tech_Middleware [style=dashed];
  Domain_User -> Tech_Middleware [style=dashed];
  Domain_Reservation -> Tech_Middleware [style=dashed];
  Domain_Order -> Tech_Middleware [style=dashed];
  Domain_Doctor -> Tech_Middleware [style=dashed];
  Domain_Warehouse -> Tech_Middleware [style=dashed];
  Domain_Admin -> Tech_Middleware [style=dashed];
}
